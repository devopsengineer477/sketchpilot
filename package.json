{
  "name": "sketchpilot-ai",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Sketch, diagram and organise ideas on a fast, local-first canvas \u2014 an independent Chrome extension.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run notices && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build && npm run check:build",
    "build:only": "npm run notices && node --max-old-space-size=6144 node_modules/vite/bin/vite.js build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "perf": "playwright test tests/e2e/perf.spec.ts --reporter=list",
    "docs:matrix": "vite-node scripts/update-test-matrix.ts",
    "test:coverage": "vitest run --coverage",
    "notices": "node scripts/build-notices.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "idb": "^8.0.4",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vite-node": "^3.2.4"
  },
  "author": "SketchPilot AI contributors",
  "license": "MIT",
  "homepage": "https://github.com/your-org/sketchpilot"
}
